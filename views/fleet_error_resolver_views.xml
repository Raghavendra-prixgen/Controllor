<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Error Resolver Form View -->
    <record id="view_fleet_error_resolver_form" model="ir.ui.view">
        <field name="name">fleet.error.resolver.form</field>
        <field name="model">fleet.error.resolver</field>
        <field name="arch" type="xml">
            <form string="AI Error Resolver &amp; Diagnostics">
                <sheet>
                    <div class="oe_title">
                        <h2>Fleet Diagnostic Engine</h2>
                        <p class="text-muted">Analyze tracebacks, duplicate XML IDs, manifest dependency errors, and apply instant remediation.</p>
                    </div>

                    <group>
                        <group string="Target Environment">
                            <field name="project_name" placeholder="e.g. acme-corp"/>
                            <field name="branch_name" placeholder="e.g. main or feat-x"/>
                        </group>
                    </group>

                    <group string="Log / Traceback Input">
                        <field name="raw_log" widget="text" placeholder="Paste server traceback or leave empty to auto-extract last failing build log..." style="font-family: monospace; min-height: 120px;"/>
                    </group>

                    <div class="mt-2 mb-3">
                        <button name="action_run_analysis" string="Diagnose &amp; Analyze Error" type="object" class="btn btn-primary" icon="fa-stethoscope"/>
                    </div>

                    <div invisible="not error_detected" class="p-3 mb-3" style="background: #fff1f2; border: 1px solid #f43f5e; border-radius: 8px;">
                        <h4 style="color: #be123c;"><i class="fa fa-exclamation-circle me-1"/> Diagnostic Results</h4>
                        <group>
                            <group>
                                <field name="error_category"/>
                                <field name="offending_module" widget="badge"/>
                            </group>
                            <group>
                                <field name="offending_file"/>
                                <field name="offending_line"/>
                            </group>
                        </group>
                        <group string="Root Cause Analysis">
                            <field name="error_summary" nolabel="1" readonly="1"/>
                        </group>
                        <group string="Recommended Remediation">
                            <field name="suggested_fix" nolabel="1" readonly="1"/>
                        </group>

                        <div invisible="not has_quick_fix" class="mt-3 p-3 bg-white border rounded">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <strong>Automated Quick-Fix Available: </strong>
                                    <field name="quick_fix_action" readonly="1" class="badge bg-success ms-2"/>
                                </div>
                                <button name="action_execute_quick_fix" string="Execute Automated Quick-Fix" type="object" class="btn btn-success" icon="fa-magic" groups="fleet_connector.group_fleet_developer"/>
                            </div>
                            <div invisible="not fix_status" class="mt-2 text-success">
                                <strong>Result: </strong><field name="fix_status" readonly="1"/>
                            </div>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_fleet_error_resolver" model="ir.actions.act_window">
        <field name="name">Diagnostics &amp; Error Resolver</field>
        <field name="res_model">fleet.error.resolver</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>
</odoo>
