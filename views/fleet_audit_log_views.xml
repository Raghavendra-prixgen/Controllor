<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Audit Log Tree View -->
    <record id="view_fleet_audit_log_tree" model="ir.ui.view">
        <field name="name">fleet.audit.log.tree</field>
        <field name="model">fleet.audit.log</field>
        <field name="arch" type="xml">
            <tree string="Fleet Audit Trail" create="false" edit="false" decoration-danger="status == 'failed'" decoration-success="status == 'success'">
                <field name="timestamp"/>
                <field name="operator" font_weight="bold"/>
                <field name="client_ip"/>
                <field name="action"/>
                <field name="project_name"/>
                <field name="branch_name"/>
                <field name="status" widget="badge" decoration-success="status == 'success'" decoration-danger="status == 'failed'"/>
                <field name="details"/>
            </tree>
        </field>
    </record>

    <!-- Audit Log Form View -->
    <record id="view_fleet_audit_log_form" model="ir.ui.view">
        <field name="name">fleet.audit.log.form</field>
        <field name="model">fleet.audit.log</field>
        <field name="arch" type="xml">
            <form string="Audit Event" create="false" edit="false">
                <sheet>
                    <div class="oe_title">
                        <label for="action" string="Audit Event Action"/>
                        <h1>
                            <field name="action"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Operator &amp; Origin">
                            <field name="timestamp"/>
                            <field name="operator"/>
                            <field name="client_ip"/>
                            <field name="status" widget="badge" decoration-success="status == 'success'" decoration-danger="status == 'failed'"/>
                        </group>
                        <group string="Target Environment">
                            <field name="project_name"/>
                            <field name="branch_name"/>
                        </group>
                    </group>
                    <group string="Event Payload &amp; Details">
                        <field name="details" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Audit Log Search View -->
    <record id="view_fleet_audit_log_search" model="ir.ui.view">
        <field name="name">fleet.audit.log.search</field>
        <field name="model">fleet.audit.log</field>
        <field name="arch" type="xml">
            <search string="Search Audit Trail">
                <field name="operator"/>
                <field name="action"/>
                <field name="project_name"/>
                <field name="branch_name"/>
                <group expand="0" string="Group By">
                    <filter string="Operator" name="group_operator" domain="[]" context="{'group_by': 'operator'}"/>
                    <filter string="Action" name="group_action" domain="[]" context="{'group_by': 'action'}"/>
                    <filter string="Project" name="group_project" domain="[]" context="{'group_by': 'project_name'}"/>
                    <filter string="Status" name="group_status" domain="[]" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_fleet_audit_log" model="ir.actions.act_window">
        <field name="name">Audit Trail</field>
        <field name="res_model">fleet.audit.log</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Sync Server Action -->
    <record id="action_server_sync_audit_logs" model="ir.actions.server">
        <field name="name">Sync Audit Trail from Fleet</field>
        <field name="model_id" ref="model_fleet_audit_log"/>
        <field name="binding_model_id" ref="model_fleet_audit_log"/>
        <field name="state">code</field>
        <field name="code">action = model.action_sync_audit_logs()</field>
    </record>
</odoo>
